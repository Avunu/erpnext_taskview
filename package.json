{
  "name": "erpnext-taskview",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "dev:dock": "BUNDLE=timerdock vite build --watch",
    "dev:portal": "vite -c vite.portal.config.ts",
    "build": "vite build && BUNDLE=timerdock vite build && vite build -c vite.portal.config.ts && node update-assets.mjs",
    "build:taskview": "vite build",
    "build:timerdock": "BUNDLE=timerdock vite build",
    "build:portal": "vite build -c vite.portal.config.ts",
    "preview": "vite preview",
    "typecheck": "node scripts/vue-tsc.cjs --noEmit && node scripts/vue-tsc.cjs --noEmit -p portal/tsconfig.json",
    "lint": "oxlint erpnext_taskview/public/js portal/src",
    "lint:fix": "oxlint --fix erpnext_taskview/public/js portal/src",
    "format": "oxfmt --write erpnext_taskview/public/js portal/src",
    "format:check": "oxfmt --check erpnext_taskview/public/js portal/src",
    "upgrade": "npx npm-check-updates -u && yarn install"
  },
  "dependencies": {
    "@he-tree/vue": "^2.10.5",
    "@vueuse/core": "^15.0.0",
    "frappe-ui": "^0.1",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3",
    "vue-demi": "^0.14.10",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^4.5.0",
    "vue3-side-panel": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@^5.9.3",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  },
  "resolutions": {
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.2"
  }
}
