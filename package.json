{
	"name": "erpnext-taskview",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"author": "Avunu LLC",
	"type": "module",
	"scripts": {
		"dev": "vite build --watch",
		"dev:dock": "BUNDLE=timerdock vite build --watch",
		"dev:portal": "vite -c vite.portal.config.ts",
		"build": "vite build && BUNDLE=timerdock vite build && vite build -c vite.portal.config.ts && node scripts/vite-register.mjs",
		"build:taskview": "vite build",
		"build:timerdock": "BUNDLE=timerdock vite build",
		"build:portal": "vite build -c vite.portal.config.ts",
		"preview": "vite preview",
		"typecheck": "tsc --build tsconfig.solution.json && node scripts/vue-tsc.cjs --noEmit -p tsconfig.json && node scripts/vue-tsc.cjs --noEmit -p portal/tsconfig.json",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix erpnext_taskview/public/js portal/src",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"upgrade": "npx npm-check-updates -u && yarn install",
		"lint:py": "uv run --frozen --project tools ruff check . && uv run --frozen --project tools ruff format --check .",
		"typecheck:py": "uv run --frozen --project tools ty check --python \"${FRAPPE_BENCH_ROOT:-.frappe-nix/bench}/env\"",
		"check": "yarn -s format:check && yarn -s lint && yarn -s typecheck",
		"ci:typecheck": "yarn -s build && test -f erpnext_taskview/www/projects.html && ! grep -qF '.__' erpnext_taskview/www/projects.html"
	},
	"dependencies": {
		"@he-tree/vue": "^2.10.5",
		"@vueuse/core": "^15.0.0",
		"frappe-ui": "^1.0",
		"lucide-vue-next": "^1.0.0",
		"vue": "^3",
		"vue-demi": "^0.14.10",
		"vue-draggable-plus": "^0.6.1",
		"vue-router": "^5.4.0",
		"vue3-side-panel": "^1.3.0"
	},
	"devDependencies": {
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-code-block": "^3.32.0",
		"@types/node": "^26.6.5",
		"@vitejs/plugin-vue": "^6.0.10",
		"frappe-types": "^16.5.0",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"postcss": "^8.5.32",
		"tailwindcss": "^3.4.17",
		"typescript": "^7.0.2",
		"typescript5": "npm:typescript@^5.9.3",
		"vite": "^8.3.5",
		"vue-tsc": "^3.3.13"
	},
	"resolutions": {
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-model": "^1.25.12",
		"prosemirror-state": "^1.4.4",
		"prosemirror-transform": "^1.12.0",
		"prosemirror-view": "^1.42.2"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "yarn@1.22.22",
	"frappe": {
		"major": "16",
		"branch": "version-16"
	}
}
