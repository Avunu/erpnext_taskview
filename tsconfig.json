{
	"extends": "frappe-types/tsconfig/base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"jsx": "preserve",
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"types": ["node", "frappe-types/global"],
		"paths": {
			"@/*": ["./erpnext_taskview/public/js/*"]
		}
	},
	"include": ["erpnext_taskview/public/js/**/*.ts", "erpnext_taskview/public/js/**/*.vue", "types/*.d.ts"],
	"exclude": ["node_modules", "erpnext_taskview/public/dist"]
}
